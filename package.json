{
  "name": "tsuka",
  "version": "0.3.0",
  "description": "TSUKA — TypeScript Unified Kit for Agents: multi-agent CLI harness",
  "main": "dist/cli/index.js",
  "bin": {
    "tsuka": "dist/cli/index.js"
  },
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "cli",
    "llm",
    "ollama",
    "openrouter",
    "typescript",
    "react-loop",
    "orchestrator"
  ],
  "files": [
    "dist",
    "roles",
    "traits",
    "characters",
    "teams",
    "presets",
    "tools_schemas",
    "benchmarks",
    "tsuka.config.json",
    "tsuka.config.json.example",
    "README.md",
    "README-it.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "tsx tests/run_tests.ts",
    "test:roles": "tsx tests/test_roles.ts",
    "test:memory": "tsx tests/test_memory.ts",
    "test:puzznic": "node workspace\\puzznic\\tests\\run_tests.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.2",
    "node-html-markdown": "^2.0.0",
    "openai": "^4.52.7",
    "ora": "^5.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
