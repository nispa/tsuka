{
  "version": 1,
  "providers": {
    "duckduckgo": {
      "displayName": "DuckDuckGo",
      "hint": "Free, no API key required",
      "transport": "dom",
      "endpoint": "https://html.duckduckgo.com/html/",
      "method": "GET",
      "query": { "q": { "source": "query" } },
      "headers": {
        "User-Agent": { "source": "literal", "value": "Mozilla/5.0 (compatible; TSUKA-WebSearch/1.0)" }
      },
      "response": { "adapter": "duckduckgo-html-v1" }
    },
    "tavily": {
      "displayName": "Tavily API",
      "hint": "Requires TAVILY_API_KEY",
      "transport": "json",
      "endpoint": "https://api.tavily.com/search",
      "method": "POST",
      "body": {
        "api_key": { "source": "env", "name": "TAVILY_API_KEY" },
        "query": { "source": "query" },
        "search_depth": { "source": "literal", "value": "basic" },
        "max_results": { "source": "maxResults" }
      },
      "headers": { "Content-Type": { "source": "literal", "value": "application/json" } },
      "response": {
        "itemsPath": "results",
        "titlePath": "title",
        "urlPath": "url",
        "snippetPath": "content"
      }
    }
  }
}
